defines = -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -Iwasm/gen -I.. -I../src/profiling/memory/include -I../include -Iwasm/gen/build_config
cflags = -fstrict-aliasing -Wformat -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -fno-omit-frame-pointer -msimd128 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Wall -Wextra -Wpedantic -Wno-c++98-compat-pedantic -Wno-c++98-compat -Wno-disabled-macro-expansion -Wno-documentation-unknown-command -Wno-gnu-include-next -Wno-gnu-statement-expression -Wno-gnu-zero-variadic-macro-arguments -Wno-padded -Wno-poison-system-directories -Wno-pre-c11-compat -Wno-reserved-id-macro -Wno-reserved-identifier -Wno-shadow-uncaptured-local -Wno-unknown-sanitizers -Wno-unknown-warning-option -Wno-unsafe-buffer-usage -Wno-switch-default -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -std=c++17
root_out_dir = wasm
target_output_name = trace_summary

build wasm/obj/src/trace_processor/trace_summary/trace_summary.inputdeps.stamp: wasm_stamp wasm/obj/gn/gen_buildflags.stamp wasm/obj/gn/standalone/check_build_deps.stamp wasm/obj/protos/perfetto/common/cpp_gen.stamp wasm/obj/protos/perfetto/common/zero_gen.stamp wasm/obj/protos/perfetto/perfetto_sql/zero_gen.stamp wasm/obj/protos/perfetto/trace/track_event/zero_gen.stamp wasm/obj/protos/perfetto/trace_processor/zero_gen.stamp wasm/obj/protos/perfetto/trace_summary/zero_gen.stamp wasm/obj/src/trace_processor/importers/proto/gen_cc_track_event_descriptor.stamp wasm/obj/src/trace_processor/trace_summary/gen_cc_trace_summary_descriptor.stamp
build wasm/obj/src/trace_processor/trace_summary/trace_summary.summary.o: wasm_cxx ../src/trace_processor/trace_summary/summary.cc || wasm/obj/src/trace_processor/trace_summary/trace_summary.inputdeps.stamp

build wasm/obj/src/trace_processor/trace_summary/trace_summary.stamp: wasm_stamp wasm/obj/src/trace_processor/trace_summary/trace_summary.summary.o || wasm/obj/src/trace_processor/trace_summary/gen_cc_trace_summary_descriptor.stamp wasm/obj/gn/default_deps.stamp wasm/obj/include/perfetto/trace_processor/trace_processor.stamp wasm/obj/include/perfetto/trace_processor/basic_types.stamp wasm/obj/protos/perfetto/trace_summary/zero.stamp wasm/obj/src/base/base.stamp wasm/obj/src/protozero/protozero.stamp wasm/obj/src/protozero/text_to_proto/text_to_proto.stamp wasm/obj/src/trace_processor/perfetto_sql/generator/generator.stamp wasm/obj/src/trace_processor/util/util.stamp wasm/obj/src/trace_processor/util/descriptors.stamp wasm/obj/src/trace_processor/util/protozero_to_text.stamp wasm/obj/include/perfetto/base/base.stamp wasm/obj/include/perfetto/public/base.stamp wasm/obj/include/perfetto/public/abi/base.stamp wasm/obj/include/perfetto/trace_processor/storage.stamp wasm/obj/protos/perfetto/perfetto_sql/zero.stamp wasm/obj/include/perfetto/protozero/protozero.stamp wasm/obj/include/perfetto/public/protozero.stamp wasm/obj/include/perfetto/ext/base/base.stamp wasm/obj/src/base/perfetto_base_default_platform.stamp wasm/obj/protos/perfetto/common/cpp.stamp wasm/obj/protos/perfetto/common/zero.stamp wasm/obj/protos/perfetto/trace_processor/zero.stamp wasm/obj/protos/perfetto/trace/track_event/zero.stamp
