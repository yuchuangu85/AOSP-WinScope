defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -Igen -I.. -I../src/profiling/memory/include -I../include -Igen/build_config
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Wall -Wextra -Wpedantic -Weverything -Wno-c++98-compat-pedantic -Wno-c++98-compat -Wno-disabled-macro-expansion -Wno-documentation-unknown-command -Wno-gnu-include-next -Wno-gnu-statement-expression -Wno-gnu-zero-variadic-macro-arguments -Wno-padded -Wno-poison-system-directories -Wno-pre-c11-compat -Wno-reserved-id-macro -Wno-reserved-identifier -Wno-shadow-uncaptured-local -Wno-unknown-sanitizers -Wno-unknown-warning-option -Wno-unsafe-buffer-usage -Wno-switch-default -Wthread-safety -Wno-thread-safety-negative -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = common

build obj/src/ipc/common.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/ipc/wire_protocol_cpp_gen.stamp
build obj/src/ipc/common.buffered_frame_deserializer.o: cxx ../src/ipc/buffered_frame_deserializer.cc || obj/src/ipc/common.inputdeps.stamp
build obj/src/ipc/common.deferred.o: cxx ../src/ipc/deferred.cc || obj/src/ipc/common.inputdeps.stamp
build obj/src/ipc/common.virtual_destructors.o: cxx ../src/ipc/virtual_destructors.cc || obj/src/ipc/common.inputdeps.stamp

build obj/src/ipc/common.stamp: stamp obj/src/ipc/common.buffered_frame_deserializer.o obj/src/ipc/common.deferred.o obj/src/ipc/common.virtual_destructors.o || obj/include/perfetto/ext/ipc/ipc.stamp obj/protos/perfetto/ipc/wire_protocol_cpp.stamp obj/gn/default_deps.stamp obj/src/base/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/base/base.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/public/protozero.stamp obj/include/perfetto/ext/base/base.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/src/protozero/protozero.stamp obj/src/base/perfetto_base_default_platform.stamp
