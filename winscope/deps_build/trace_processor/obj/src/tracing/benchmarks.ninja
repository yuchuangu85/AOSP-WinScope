egular_zero_gen.stamp obj/protos/perfetto/trace/android/zero_gen.stamp obj/protos/perfetto/trace/chrome/zero_gen.stamp obj/protos/perfetto/trace/etw/zero_gen.stamp obj/protos/perfetto/trace/filesystem/zero_gen.stamp obj/protos/perfetto/trace/ftrace/zero_gen.stamp obj/protos/perfetto/trace/generic_kernel/zero_gen.stamp obj/protos/perfetto/trace/gpu/zero_gen.stamp obj/protos/perfetto/trace/interned_data/zero_gen.stamp obj/protos/perfetto/trace/perfetto/zero_gen.stamp obj/protos/perfetto/trace/power/zero_gen.stamp obj/protos/perfetto/trace/profiling/zero_gen.stamp obj/protos/perfetto/trace/ps/zero_gen.stamp obj/protos/perfetto/trace/statsd/zero_gen.stamp obj/protos/perfetto/trace/sys_stats/zero_gen.stamp obj/protos/perfetto/trace/system_info/zero_gen.stamp obj/protos/perfetto/trace/track_event/cpp_gen.stamp obj/protos/perfetto/trace/track_event/zero_gen.stamp obj/protos/perfetto/trace/translation/zero_gen.stamp obj/src/base/version_gen_h.stamp

