defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DZLIB_IMPLEMENTATION -DCHROMIUM_ZLIB_NO_CHROMECONF -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -I.. -I../src/profiling/memory/include -I../include -Igen/build_config -Igen
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -mlzcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Wall -Wextra -Wpedantic -Weverything -Wno-c++98-compat-pedantic -Wno-c++98-compat -Wno-disabled-macro-expansion -Wno-documentation-unknown-command -Wno-gnu-include-next -Wno-gnu-statement-expression -Wno-gnu-zero-variadic-macro-arguments -Wno-padded -Wno-poison-system-directories -Wno-pre-c11-compat -Wno-reserved-id-macro -Wno-reserved-identifier -Wno-shadow-uncaptured-local -Wno-unknown-sanitizers -Wno-unknown-warning-option -Wno-unsafe-buffer-usage -Wno-switch-default -Wthread-safety -Wno-thread-safety-negative -fvisibility=hidden -O3 -fdata-sections -ffunction-sections -isystem ../buildtools/zlib -Wno-unknown-warning-option -Wno-deprecated-non-prototype -Wno-macro-redefined
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = pprofbuilder

build obj/src/traceconv/pprofbuilder.pprof_builder.o: cxx ../src/traceconv/pprof_builder.cc || obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/common/zero_gen.stamp obj/protos/perfetto/config/zero_gen.stamp obj/protos/perfetto/config/android/zero_gen.stamp obj/protos/perfetto/config/ftrace/zero_gen.stamp obj/protos/perfetto/config/gpu/zero_gen.stamp obj/protos/perfetto/config/inode_file/zero_gen.stamp obj/protos/perfetto/config/interceptors/zero_gen.stamp obj/protos/perfetto/config/power/zero_gen.stamp obj/protos/perfetto/config/priority_boost/zero_gen.stamp obj/protos/perfetto/config/process_stats/zero_gen.stamp obj/protos/perfetto/config/profiling/zero_gen.stamp obj/protos/perfetto/config/statsd/zero_gen.stamp obj/protos/perfetto/config/sys_stats/zero_gen.stamp obj/protos/perfetto/config/system_info/zero_gen.stamp obj/protos/perfetto/config/track_event/zero_gen.stamp obj/protos/perfetto/perfetto_sql/zero_gen.stamp obj/protos/perfetto/trace/minimal_zero_gen.stamp obj/protos/perfetto/trace/non_minimal_zero_gen.stamp obj/protos/perfetto/trace/android/winscope_common_zero_gen.stamp obj/protos/perfetto/trace/android/winscope_regular_zero_gen.stamp obj/protos/perfetto/trace/android/zero_gen.stamp obj/protos/perfetto/trace/chrome/zero_gen.stamp obj/protos/perfetto/trace/etw/zero_gen.stamp obj/protos/perfetto/trace/filesystem/zero_gen.stamp obj/protos/perfetto/trace/ftrace/zero_gen.stamp obj/protos/perfetto/trace/generic_kernel/zero_gen.stamp obj/protos/perfetto/trace/gpu/zero_gen.stamp obj/protos/perfetto/trace/interned_data/zero_gen.stamp obj/protos/perfetto/trace/perfetto/zero_gen.stamp obj/protos/perfetto/trace/power/zero_gen.stamp obj/protos/perfetto/trace/profiling/zero_gen.stamp obj/protos/perfetto/trace/ps/zero_gen.stamp obj/protos/perfetto/trace/statsd/zero_gen.stamp obj/protos/perfetto/trace/sys_stats/zero_gen.stamp obj/protos/perfetto/trace/system_info/zero_gen.stamp obj/protos/perfetto/trace/track_event/zero_gen.stamp o