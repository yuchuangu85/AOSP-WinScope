defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DGOOGLE_PROTOBUF_NO_RTTI -DGOOGLE_PROTOBUF_NO_STATIC_INITIALIZER
include_dirs = -I../buildtools/libcxx_config -Igen
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -mlzcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections -isystem ../buildtools/protobuf/src
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = testing_messages_lite

build obj/src/protozero/testing_messages_lite.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/src/protozero/testing_messages_lite_gen.stamp obj/src/protozero/testing_messages_other_package_lite_gen.stamp obj/src/protozero/testing_messages_subpackage_lite_gen.stamp
build obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.extensions.pb.o: cxx gen/src/protozero/test/example_proto/extensions.pb.cc || obj/src/protozero/testing_messages_lite.inputdeps.stamp
build obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.library.pb.o: cxx gen/src/protozero/test/example_proto/library.pb.cc || obj/src/protozero/testing_messages_lite.inputdeps.stamp
build obj/trace_processor_build/gen/src/protozero/test/example_proto/library_internals/testing_messages_lite.galaxies.pb.o: cxx gen/src/protozero/test/example_proto/library_internals/galaxies.pb.cc || obj/src/protozero/testing_messages_lite.inputdeps.stamp
build obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.test_messages.pb.o: cxx gen/src/protozero/test/example_proto/test_messages.pb.cc || obj/src/protozero/testing_messages_lite.inputdeps.stamp
build obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.upper_import.pb.o: cxx gen/src/protozero/test/example_proto/upper_import.pb.cc || obj/src/protozero/testing_messages_lite.inputdeps.stamp

build obj/src/protozero/testing_messages_lite.stamp: stamp obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.extensions.pb.o obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.library.pb.o obj/trace_processor_build/gen/src/protozero/test/example_proto/library_internals/testing_messages_lite.galaxies.pb.o obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.test_messages.pb.o obj/trace_processor_build/gen/src/protozero/test/example_proto/testing_messages_lite.upper_import.pb.o || obj/gn/protobuf_lite.stamp obj/src/protozero/testing_messages_lite_gen.stamp obj/src/protozero/testing_messages_other_package_lite.stamp obj/src/protozero/testing_messages_subpackage_lite.stamp obj/buildtools/protobuf_lite.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp
