defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -I.. -I../src/profiling/memory/include -I../include -Igen/build_config -Igen
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -Wall -Wextra -Wpedantic -Weverything -Wno-c++98-compat-pedantic -Wno-c++98-compat -Wno-disabled-macro-expansion -Wno-documentation-unknown-command -Wno-gnu-include-next -Wno-gnu-statement-expression -Wno-gnu-zero-variadic-macro-arguments -Wno-padded -Wno-poison-system-directories -Wno-pre-c11-compat -Wno-reserved-id-macro -Wno-reserved-identifier -Wno-shadow-uncaptured-local -Wno-unknown-sanitizers -Wno-unknown-warning-option -Wno-unsafe-buffer-usage -Wno-switch-default -Wthread-safety -Wno-thread-safety-negative -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = protozero_to_json

build obj/src/trace_processor/util/protozero_to_json.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/common/zero_gen.stamp obj/protos/perfetto/perfetto_sql/zero_gen.stamp obj/protos/perfetto/trace/track_event/zero_gen.stamp obj/protos/perfetto/trace_processor/zero_gen.stamp obj/src/trace_processor/importers/proto/gen_cc_track_event_descriptor.stamp
build obj/src/trace_processor/util/protozero_to_json.protozero_to_json.o: cxx ../src/trace_processor/util/protozero_to_json.cc || obj/src/trace_processor/util/protozero_to_json.inputdeps.stamp

build obj/src/trace_processor/util/protozero_to_json.stamp: stamp obj/src/trace_processor/util/protozero_to_json.protozero_to_json.o || obj/src/trace_processor/util/descriptors.stamp obj/gn/default_deps.stamp obj/protos/perfetto/common/zero.stamp obj/protos/perfetto/trace/track_event/zero.stamp obj/src/base/base.stamp obj/src/protozero/protozero.stamp obj/src/trace_processor/importers/proto/gen_cc_track_event_descriptor.stamp obj/src/trace_processor/util/util.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/include/perfetto/trace_processor/basic_types.stamp obj/include/perfetto/base/base.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/public/protozero.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp obj/protos/perfetto/trace_processor/zero.stamp obj/protos/perfetto/perfetto_sql/zero.stamp
