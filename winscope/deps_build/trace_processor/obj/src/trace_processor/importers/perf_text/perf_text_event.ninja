defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -I.. -I../src/profiling/memory/include -I../include -Igen/build_config -Igen
root_out_dir = .
target_output_name = perf_text_event


build obj/src/trace_processor/importers/perf_text/perf_text_event.stamp: stamp || obj/gn/default_deps.stamp obj/src/trace_processor/containers/containers.stamp obj/src/trace_processor/tables/tables.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/base/base.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/public/protozero.stamp obj/protos/perfetto/trace_processor/zero.stamp obj/protos/perfetto/common/zero.stamp obj/src/protozero/protozero.stamp obj/src/base/base.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp obj/protos/perfetto/perfetto_sql/zero.stamp obj/protos/perfetto/trace_summary/zero.stamp obj/src/trace_processor/dataframe/dataframe.stamp obj/src/trace_processor/dataframe/specs.stamp obj/src/trace_processor/util/glob.stamp obj/src/trace_processor/util/regex.stamp obj/src/trace_processor/dataframe/impl/impl.stamp
