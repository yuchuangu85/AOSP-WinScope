defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -Igen -I.. -I../src/profiling/memory/include -I../include -Igen/build_config
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -mlzcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = cpp

build obj/protos/perfetto/trace_summary/cpp.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/perfetto_sql/cpp_gen.stamp obj/protos/perfetto/trace_summary/cpp_gen.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace_summary/cpp.file.gen.o: cxx gen/protos/perfetto/trace_summary/file.gen.cc || obj/protos/perfetto/trace_summary/cpp.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace_summary/cpp.v2_metric.gen.o: cxx gen/protos/perfetto/trace_summary/v2_metric.gen.cc || obj/protos/perfetto/trace_summary/cpp.inputdeps.stamp

build obj/protos/perfetto/trace_summary/cpp.stamp: stamp obj/trace_processor_build/gen/protos/perfetto/trace_summary/cpp.file.gen.o obj/trace_processor_build/gen/protos/perfetto/trace_summary/cpp.v2_metric.gen.o || obj/protos/perfetto/trace_summary/cpp_gen.stamp obj/protos/perfetto/perfetto_sql/cpp.stamp obj/gn/default_deps.stamp obj/include/perfetto/base/base.stamp obj/src/protozero/protozero.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/public/protozero.stamp obj/src/base/base.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp
