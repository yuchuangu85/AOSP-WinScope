defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -Igen -I.. -I../src/profiling/memory/include -I../include -Igen/build_config
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = minimal_zero

build obj/protos/perfetto/trace/minimal_zero.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/common/zero_gen.stamp obj/protos/perfetto/config/zero_gen.stamp obj/protos/perfetto/config/android/zero_gen.stamp obj/protos/perfetto/config/ftrace/zero_gen.stamp obj/protos/perfetto/config/gpu/zero_gen.stamp obj/protos/perfetto/config/inode_file/zero_gen.stamp obj/protos/perfetto/config/interceptors/zero_gen.stamp obj/protos/perfetto/config/power/zero_gen.stamp obj/protos/perfetto/config/process_stats/zero_gen.stamp obj/protos/perfetto/config/profiling/zero_gen.stamp obj/protos/perfetto/config/statsd/zero_gen.stamp obj/protos/perfetto/config/sys_stats/zero_gen.stamp obj/protos/perfetto/config/system_info/zero_gen.stamp obj/protos/perfetto/config/track_event/zero_gen.stamp obj/protos/perfetto/trace/minimal_zero_gen.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.clock_snapshot.pbzero.o: cxx gen/protos/perfetto/trace/clock_snapshot.pbzero.cc || obj/protos/perfetto/trace/minimal_zero.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.trace_uuid.pbzero.o: cxx gen/protos/perfetto/trace/trace_uuid.pbzero.cc || obj/protos/perfetto/trace/minimal_zero.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.trigger.pbzero.o: cxx gen/protos/perfetto/trace/trigger.pbzero.cc || obj/protos/perfetto/trace/minimal_zero.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.system_info.pbzero.o: cxx gen/protos/perfetto/trace/system_info.pbzero.cc || obj/protos/perfetto/trace/minimal_zero.inputdeps.stamp

build obj/protos/perfetto/trace/minimal_zero.stamp: stamp obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.clock_snapshot.pbzero.o obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.trace_uuid.pbzero.o obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.trigger.pbzero.o obj/trace_processor_build/gen/protos/perfetto/trace/minimal_zero.system_info.pbzero.o || obj/protos/perfetto/trace/minimal_zero_gen.stamp obj/protos/perfetto/config/zero.stamp obj/src/protozero/protozero.stamp obj/protos/perfetto/common/zero.stamp obj/include/perfetto/base/base.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/public/protozero.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/src/base/base.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp obj/protos/perfetto/config/android/zero.stamp obj/protos/perfetto/config/ftrace/zero.stamp obj/protos/perfetto/config/gpu/zero.stamp obj/protos/perfetto/config/inode_file/zero.stamp obj/protos/perfetto/config/interceptors/zero.stamp obj/protos/perfetto/config/power/zero.stamp obj/protos/perfetto/config/process_stats/zero.stamp obj/protos/perfetto/config/profiling/zero.stamp obj/protos/perfetto/config/statsd/zero.stamp obj/protos/perfetto/config/sys_stats/zero.stamp obj/protos/perfetto/config/system_info/zero.stamp obj/protos/perfetto/config/track_event/zero.stamp
