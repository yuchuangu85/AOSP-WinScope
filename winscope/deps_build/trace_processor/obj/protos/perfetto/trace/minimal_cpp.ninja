defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -Igen -I.. -I../src/profiling/memory/include -I../include -Igen/build_config
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -mlzcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = minimal_cpp

build obj/protos/perfetto/trace/minimal_cpp.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/common/cpp_gen.stamp obj/protos/perfetto/config/cpp_gen.stamp obj/protos/perfetto/config/android/cpp_gen.stamp obj/protos/perfetto/config/ftrace/cpp_gen.stamp obj/protos/perfetto/config/gpu/cpp_gen.stamp obj/protos/perfetto/config/inode_file/cpp_gen.stamp obj/protos/perfetto/config/interceptors/cpp_gen.stamp obj/protos/perfetto/config/power/cpp_gen.stamp obj/protos/perfetto/config/priority_boost/cpp_gen.stamp obj/protos/perfetto/config/process_stats/cpp_gen.stamp obj/protos/perfetto/config/profiling/cpp_gen.stamp obj/protos/perfetto/config/statsd/cpp_gen.stamp obj/protos/perfetto/config/sys_stats/cpp_gen.stamp obj/protos/perfetto/config/system_info/cpp_gen.stamp obj/protos/perfetto/config/track_event/cpp_gen.stamp obj/protos/perfetto/trace/minimal_cpp_gen.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_cpp.clock_snapshot.gen.o: cxx gen/protos/perfetto/trace/clock_snapshot.gen.cc || obj/protos/perfetto/trace/minimal_cpp.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_cpp.trace_uuid.gen.o: cxx gen/protos/perfetto/trace/trace_uuid.gen.cc || obj/protos/perfetto/trace/minimal_cpp.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/minimal_cpp.trigger.gen.o: cxx gen/protos/perfetto/trace/trigger.gen.cc || obj/protos/perfetto/trace/minimal_cpp.inputdeps.stamp

build obj/protos/perfetto/trace/minimal_cpp.stamp: stamp obj/trace_processor_build/gen/protos/perfetto/trace/minimal_cpp.clock_snapshot.gen.o obj/trace_processor_build/gen/protos/perfetto/trace/minimal_cpp.trace_uuid.gen.o obj/trace_processor_build/gen/protos/perfetto/trace/minimal_cpp.trigger.gen.o || obj/protos/perfetto/trace/minimal_cpp_gen.stamp obj/protos/perfetto/config/cpp.stamp obj/gn/default_deps.stamp obj/include/perfetto/base/base.stamp obj/src/protozero/protozero.stamp obj/protos/perfetto/common/cpp.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/public/protozero.stamp obj/src/base/base.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp obj/protos/perfetto/config/android/cpp.stamp obj/protos/perfetto/config/ftrace/cpp.stamp obj/protos/perfetto/config/gpu/cpp.stamp obj/protos/perfetto/config/inode_file/cpp.stamp obj/protos/perfetto/config/interceptors/cpp.stamp obj/protos/perfetto/config/power/cpp.stamp obj/protos/perfetto/config/priority_boost/cpp.stamp obj/protos/perfetto/config/process_stats/cpp.stamp obj/protos/perfetto/config/profiling/cpp.stamp obj/protos/perfetto/config/statsd/cpp.stamp obj/protos/perfetto/config/sys_stats/cpp.stamp obj/protos/perfetto/config/system_info/cpp.stamp obj/protos/perfetto/config/track_event/cpp.stamp
