defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DGOOGLE_PROTOBUF_NO_RTTI -DGOOGLE_PROTOBUF_NO_STATIC_INITIALIZER
include_dirs = -I../buildtools/libcxx_config -Igen
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -mlzcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections -isystem ../buildtools/protobuf/src
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = winscope_common_lite

build obj/protos/perfetto/trace/android/winscope_common_lite.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/trace/android/winscope_common_lite_gen.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/android/graphics/winscope_common_lite.insets.pb.o: cxx gen/protos/perfetto/trace/android/graphics/insets.pb.cc || obj/protos/perfetto/trace/android/winscope_common_lite.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/android/graphics/winscope_common_lite.point.pb.o: cxx gen/protos/perfetto/trace/android/graphics/point.pb.cc || obj/protos/perfetto/trace/android/winscope_common_lite.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/android/graphics/winscope_common_lite.rect.pb.o: cxx gen/protos/perfetto/trace/android/graphics/rect.pb.cc || obj/protos/perfetto/trace/android/winscope_common_lite.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace/android/winscope_common_lite.winscope_extensions.pb.o: cxx gen/protos/perfetto/trace/android/winscope_extensions.pb.cc || obj/protos/perfetto/trace/android/winscope_common_lite.inputdeps.stamp

build obj/protos/perfetto/trace/android/winscope_common_lite.stamp: stamp obj/trace_processor_build/gen/protos/perfetto/trace/android/graphics/winscope_common_lite.insets.pb.o obj/trace_processor_build/gen/protos/perfetto/trace/android/graphics/winscope_common_lite.point.pb.o obj/trace_processor_build/gen/protos/perfetto/trace/android/graphics/winscope_common_lite.rect.pb.o obj/trace_processor_build/gen/protos/perfetto/trace/android/winscope_common_lite.winscope_extensions.pb.o || obj/gn/protobuf_lite.stamp obj/protos/perfetto/trace/android/winscope_common_lite_gen.stamp obj/buildtools/protobuf_lite.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp
