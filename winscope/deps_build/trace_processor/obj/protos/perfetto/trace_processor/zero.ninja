defines = -D_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS -D_LIBCXXABI_DISABLE_VISIBILITY_ANNOTATIONS -DNDEBUG -DPERFETTO_IMPLEMENTATION
include_dirs = -I../buildtools/libcxx_config -Igen -I.. -I../src/profiling/memory/include -I../include -Igen/build_config
cflags = -fstrict-aliasing -Wformat -g -fPIC -fstack-protector-strong -Werror -fcolor-diagnostics -fdiagnostics-show-template-tree -Wno-c99-designator -fno-omit-frame-pointer -mbmi -mbmi2 -mavx2 -mpopcnt -mlzcnt -msse4.2 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -fvisibility=hidden -O3 -fdata-sections -ffunction-sections
cflags_cc = -fno-exceptions -fno-rtti -nostdinc++ -isystem../buildtools/libcxx/include -isystem../buildtools/libcxxabi/include -std=c++17
root_out_dir = .
target_output_name = zero

build obj/protos/perfetto/trace_processor/zero.inputdeps.stamp: stamp obj/gn/gen_buildflags.stamp obj/gn/standalone/check_build_deps.stamp obj/protos/perfetto/common/zero_gen.stamp obj/protos/perfetto/perfetto_sql/zero_gen.stamp obj/protos/perfetto/trace_processor/zero_gen.stamp obj/protos/perfetto/trace_summary/zero_gen.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.metatrace_categories.pbzero.o: cxx gen/protos/perfetto/trace_processor/metatrace_categories.pbzero.cc || obj/protos/perfetto/trace_processor/zero.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.serialization.pbzero.o: cxx gen/protos/perfetto/trace_processor/serialization.pbzero.cc || obj/protos/perfetto/trace_processor/zero.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.stack.pbzero.o: cxx gen/protos/perfetto/trace_processor/stack.pbzero.cc || obj/protos/perfetto/trace_processor/zero.inputdeps.stamp
build obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.trace_processor.pbzero.o: cxx gen/protos/perfetto/trace_processor/trace_processor.pbzero.cc || obj/protos/perfetto/trace_processor/zero.inputdeps.stamp

build obj/protos/perfetto/trace_processor/zero.stamp: stamp obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.metatrace_categories.pbzero.o obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.serialization.pbzero.o obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.stack.pbzero.o obj/trace_processor_build/gen/protos/perfetto/trace_processor/zero.trace_processor.pbzero.o || obj/protos/perfetto/trace_processor/zero_gen.stamp obj/protos/perfetto/common/zero.stamp obj/protos/perfetto/perfetto_sql/zero.stamp obj/protos/perfetto/trace_summary/zero.stamp obj/src/protozero/protozero.stamp obj/include/perfetto/base/base.stamp obj/include/perfetto/public/base.stamp obj/include/perfetto/public/abi/base.stamp obj/include/perfetto/protozero/protozero.stamp obj/include/perfetto/public/protozero.stamp obj/buildtools/libc++.stamp obj/buildtools/libc++abi.stamp obj/src/base/base.stamp obj/include/perfetto/ext/base/base.stamp obj/src/base/perfetto_base_default_platform.stamp
