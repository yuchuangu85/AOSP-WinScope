{
    "name": "@ephesoft/webpack.istanbul.loader",
    "version": "2.2.0",
    "author": "Ephesoft",
    "description": "Istanbul loader for webpack to instrument files for code coverage.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://bitbucket.org/ephesoft/webpack.istanbul.loader.git"
    },
    "files": [
        "*"
    ],
    "scripts": {
        "audit": "npm audit --registry=https://registry.npmjs.org/",
        "audit:fix": "npm audit fix --registry=https://registry.npmjs.org/",
        "build": "tsc",
        "clean": "rimraf dist .nyc_output coverage test-reports lint docs \"*.tgz\"",
        "clean:docs": "rimraf docs",
        "create:beta": "eph npm create-beta",
        "docs": "npm run clean:docs && typedoc --plugin none",
        "docs:bitbucket": "npm run clean:docs && typedoc --theme bitbucket",
        "lint": "eslint --ignore-path .gitignore --ext .ts .",
        "lint:fix": "npm run lint -- --fix",
        "lint:report": "npm run lint -- -f json -o ./lint/lint_report.json",
        "pack": "npm run build && eph build pack",
        "postbuild": "eph build post",
        "postprepare": "husky install",
        "prebuild": "npm run clean",
        "start": "tsc --watch",
        "test": "npm run test:unit",
        "test:unit": "nyc --reporter=lcov --reporter=text mocha \"test/unit/**/*.test.ts\"",
        "validate:ga": "eph validate ga",
        "validate:beta": "eph validate beta"
    },
    "eslintConfig": {
        "extends": [
            "plugin:@ephesoft/typescript"
        ],
        "parserOptions": {
            "project": [
                "tsconfig.json",
                "test/tsconfig.json"
            ]
        }
    },
    "peerDependencies": {
        "webpack": ">=5.74.0"
    },
    "prettier": "@ephesoft/prettier-config",
    "dependencies": {
        "convert-source-map": "1.8.0",
        "istanbul-lib-instrument": "5.2.0",
        "loader-utils": "1.4.0",
        "schema-utils": "2.7.1"
    },
    "devDependencies": {
        "@ephesoft/build": "1.0.0",
        "@ephesoft/eslint-plugin": "2.14.0",
        "@ephesoft/mocha-reporter": "2.7.0",
        "@ephesoft/prettier-config": "1.6.0",
        "@types/chai": "4.3.3",
        "@types/convert-source-map": "1.5.2",
        "@types/istanbul-lib-instrument": "1.7.4",
        "@types/loader-utils": "2.0.3",
        "@types/mocha": "10.0.0",
        "@types/node": "16.11.62",
        "@types/source-map": "0.5.7",
        "chai": "4.3.6",
        "eslint": "8.24.0",
        "husky": "8.0.1",
        "lint-staged": "13.0.3",
        "mocha": "10.0.0",
        "nyc": "15.1.0",
        "prettier": "2.7.1",
        "rimraf": "3.0.2",
        "ts-loader": "9.4.1",
        "ts-node": "10.9.1",
        "typedoc": "0.23.15",
        "typedoc-bitbucket-theme": "1.0.0",
        "typedoc-plugin-markdown": "3.13.6",
        "typescript": "4.8.4",
        "webpack": "5.74.0"
    }
}
