{
  "name": "winscope",
  "version": "17.0.1",
  "scripts": {
    "toolchain:verify": "python3 scripts/dependencies.py verify-toolchain --json",
    "deps:generate-lock": "python3 scripts/dependencies.py generate-lock",
    "deps:prepare": "python3 scripts/dependencies.py prepare",
    "deps:verify": "python3 scripts/dependencies.py verify --json",
    "deps:offline-check": "python3 scripts/dependencies.py offline-check --json",
    "format:check": "npm run eslint:check",
    "format:fix": "npm run eslint:fix",
    "prettier:check": "(find src/ -regextype egrep -regex '^.*(\\.ts|\\.js|\\.css|\\.ng.html)$') |xargs npx prettier --check",
    "prettier:fix": "(find src/ -regextype egrep -regex '^.*(\\.ts|\\.js|\\.css|\\.ng.html)$') |xargs npx prettier --write",
    "eslint:check": "find src -type f \\( -name '*.ts' -o -name '*.js' \\) -print0 | xargs -0 npx eslint --format=unix --no-warn-ignored",
    "eslint:fix": "find src -type f \\( -name '*.ts' -o -name '*.js' \\) -print0 | xargs -0 npx eslint --format=unix --fix --no-warn-ignored",
    "tslint:check": "find src/ -regextype egrep -regex '^.*\\.ts$' |xargs npx tslint -c google.tslint.json",
    "tslint:fix": "find src/ -regextype egrep -regex '^.*\\.ts$' |xargs npx tslint -c google.tslint.json --fix",
    "deps_graph:check_cycles": "npx madge --extensions ts,js src/ --circular",
    "start": "ng serve winscope --open",
    "start:remote_tool_mock": "ng serve remote-tool-mock --open",
    "build:trace_processor": "python3 scripts/build.py trace-processor",
    "build:prod": "python3 scripts/build.py production",
    "build:verify": "python3 scripts/build.py verify --json",
    "build:protos": "node protos/build.js",
    "build:app": "ng build winscope --configuration=production",
    "build:dev": "ng build winscope",
    "install:chromedriver": "chrome_version=$(google-chrome --version |cut -d' ' -f3); rm -rf deps_build/chromedriver-linux64 && mkdir -p deps_build/chromedriver-linux64 && (cd deps_build/chromedriver-linux64 && wget https://storage.googleapis.com/chrome-for-testing-public/${chrome_version}/linux64/chromedriver-linux64.zip && cd .. && unzip chromedriver-linux64/chromedriver-linux64.zip)",
    "test:unit:ci": "ng test winscope --configuration=ci --no-watch --no-progress",
    "test:unit:dev": "ng test winscope",
    "test:e2e": "node scripts/run_e2e.js",
    "test:presubmit": "npm run build:protos && npm run format:check && npm run test:unit:ci && npm run deps_graph:check_cycles",
    "test:all": "npm run format:check && npm run test:unit:ci && npm run test:e2e && npm run deps_graph:check_cycles",
    "build:launchers": "python3 scripts/build-launchers.py",
    "release:package": "python3 scripts/release.py package --json",
    "release:verify": "python3 scripts/release.py verify --json",
    "release:double-build": "python3 scripts/release.py double-build --json --evidence dist/validation/reproducibility.json",
    "build:release": "npm run build:prod && npm run build:launchers && npm run release:package",
    "validate:report": "python3 scripts/validate.py report --json",
    "validate:gate": "python3 scripts/validate.py gate --json --require-complete",
    "validate:runtime": "python3 scripts/validate.py gate --json --run-unit --run-e2e --run-production-e2e --run-offline --run-security",
    "features:verify": "python3 scripts/verify-feature-stages.py --json",
    "test:e2e:prod": "node scripts/run_e2e.js --production",
    "publish:candidate": "python3 scripts/publish.py publish --json",
    "publish:verify": "python3 scripts/publish.py verify --json",
    "security:hostile": "python3 -m unittest tests/test_security.py && go test ./cmd/launcher",
    "security:scan": "python3 scripts/security-scan.py --json",
    "security:audit": "python3 scripts/npm_audit_policy.py --json",
    "publish:alpha": "python3 scripts/publish.py publish --version 17.0.1-alpha.1 --json",
    "publish:rc": "python3 scripts/publish.py publish --version 17.0.1-rc.1 --json",
    "publish:stable": "python3 scripts/publish.py publish --version 17.0.1 --tag v17.0.1 --json",
    "support:verify": "python3 scripts/support.py verify --json",
    "security:advisory-verify": "python3 scripts/support.py verify-advisory --json",
    "aps:verify": "python3 scripts/verify-aps-release.py --json",
    "release:settings": "python3 scripts/verify-release-settings.py --repository yuchuangu85/AOSP-WinScope --json",
    "release:image": "python3 scripts/verify-release-image.py --json",
    "installers:package": "python3 scripts/package-installers.py"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.3.29",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.29",
    "@angular/compiler": "20.3.29",
    "@angular/core": "20.3.29",
    "@angular/elements": "20.3.29",
    "@angular/forms": "20.3.29",
    "@angular/material": "20.2.14",
    "@angular/platform-browser": "20.3.29",
    "@angular/platform-browser-dynamic": "20.3.29",
    "@angular/router": "20.3.29",
    "@auth0/auth0-angular": "^2.3.0",
    "@swc/core": "^1.15.5",
    "auth0": "^5.2.0",
    "dateformat": "^5.0.3",
    "gl-matrix": "^3.4.4",
    "google-protobuf": "^3.21.2",
    "html2canvas": "^1.4.1",
    "jsbn": "^1.1.0",
    "jszip": "^3.10.1",
    "karma-spec-reporter": "^0.0.36",
    "mp4box": "^2.3.0",
    "rxjs": "~7.8.2",
    "three": "^0.182.0",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "typescript-logging": "^2.2.0",
    "typescript-logging-log4ts-style": "^2.2.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.34",
    "@angular/cli": "20.3.34",
    "@angular/compiler-cli": "20.3.29",
    "@types/chrome": "^0.1.4",
    "@types/dateformat": "^5.0.2",
    "@types/google-protobuf": "^3.15.6",
    "@types/gtag.js": "^0.0.20",
    "@types/jasmine": "~5.1.4",
    "@types/jquery": "^3.5.30",
    "@types/node": "^24.10.0",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/three": "^0.182.0",
    "@types/w3c-web-usb": "^1.0.10",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-unix": "^8.40.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "grpc-tools": "^1.12.4",
    "jasmine": "^5.9.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-sourcemap-loader": "^0.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.7.0",
    "sass": "^1.77.8",
    "selenium-webdriver": "^4.47.0",
    "ts-protoc-gen": "^0.15.0"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  }
}
